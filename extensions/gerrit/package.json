{
  "name": "@openclaw/gerrit",
  "version": "2026.2.26",
  "description": "OpenClaw Gerrit code review channel plugin",
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.20"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "gerrit",
      "label": "Gerrit",
      "selectionLabel": "Gerrit (code review)",
      "detailLabel": "Gerrit",
      "docsPath": "/channels/gerrit",
      "docsLabel": "gerrit",
      "blurb": "Gerrit code review via SSH stream-events.",
      "aliases": [],
      "order": 90
    },
    "install": {
      "npmSpec": "@openclaw/gerrit",
      "localPath": "extensions/gerrit",
      "defaultChoice": "npm"
    }
  }
}
